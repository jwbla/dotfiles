<?xml version="1.0" encoding="UTF-8"?>
<!-- {{stamp}} -->
<!-- The lock screen's NeuAvatar (size="lg", status="online"), rasterised because
     hyprlock can only place images. Raised disc, brand initials, and the online
     dot ringed by the ground so it reads as a badge, per .neu-avatar-status. -->
<svg xmlns="http://www.w3.org/2000/svg" width="256" height="256" viewBox="0 0 256 256">
  <defs>
    <filter id="raised" x="-50%" y="-50%" width="200%" height="200%"
            color-interpolation-filters="sRGB">
      <feDropShadow dx="9" dy="9" stdDeviation="9"
                    flood-color="{{shadowDark}}" flood-opacity="0.9"/>
      <feDropShadow dx="-9" dy="-9" stdDeviation="9"
                    flood-color="{{shadowLight}}" flood-opacity="0.75"/>
    </filter>
    <linearGradient id="face" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="{{hoverHighlight}}"/>
      <stop offset="100%" stop-color="{{bgComponent}}"/>
    </linearGradient>
  </defs>
  <circle cx="128" cy="128" r="86" fill="url(#face)" filter="url(#raised)"/>
  <text x="128" y="130" text-anchor="middle" dominant-baseline="central"
        font-family="{{family_mono}}" font-size="68" font-weight="{{weight_bold}}"
        letter-spacing="3" fill="{{primary}}">{{user_initials}}</text>
  <circle cx="190" cy="190" r="20" fill="{{bg}}"/>
  <circle cx="190" cy="190" r="14" fill="{{success}}"/>
</svg>
