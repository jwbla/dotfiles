# ghostty. See `ghostty +show-config --default --docs` for everything available.

font-family = UbuntuMono Nerd Font
font-size = 14

# @rgtv/neu, generated by theme/gen.py into ghostty/themes/neu.
# Revert the terminal on its own with: theme = Catppuccin Mocha
theme = neu

# Fully opaque, so the terminal ground IS --neu-bg (#141414) rather than #141414
# blended with whatever is behind it. The DS ground is a flat near-black and the
# bar/panels sit on exactly that value; a translucent terminal would read as a
# different, wallpaper-tinted colour right next to them.
background-opacity = 1.0

window-padding-x = 8
window-padding-y = 6
window-decoration = none
confirm-close-surface = false
