# Environment for bin/neu-llm.py -- the LLM sidebar's backend.
#
# Copy to ~/.config/neu/llm.env and fill in. The quickshell service reads this
# file before every turn, so a change takes effect on the next message -- no
# shell restart:
#
#   install -d -m 700 ~/.config/neu
#   install -m 600 /dev/null ~/.config/neu/llm.env
#   $EDITOR ~/.config/neu/llm.env
#
# If it holds a token, it holds a secret: keep it 0600 and never commit it.

# Base URL of the OpenAI-compatible server, no trailing slash.
# LM Studio: Developer tab -> Start Server, and turn ON "Serve on Local Network"
# if the model is on another box. Its default listener is port 1234.
#NEU_LLM_URL=http://<lm-studio-host>:1234/v1

# Model id to request. Leave unset and the script asks /v1/models and takes the
# first one loaded, which is what you want when LM Studio holds exactly one.
#NEU_LLM_MODEL=openai/gpt-oss-20b

# Bearer token. LM Studio ignores it; llama-server and friends may not.
#NEU_LLM_KEY=

# --- which harness answers ---------------------------------------------------

# builtin | pi | opencode. Read by bin/neu-llm-harness.sh, which dispatches to
# the adapter for whichever you name; the panel's menu writes the same choice to
# ~/.local/state/neu/llm/harness. `neu-llm-harness.sh --detect` lists what is
# installed here.
#
# The builtin is the default on purpose: pi and opencode carry ~10k-token system
# prompts, which fail outright against a model loaded with a small context. Raise
# the context in LM Studio before switching.
#NEU_LLM_HARNESS=builtin

# pi only: which provider name pi should use for this endpoint. The adapter
# passes NEU_LLM_URL through as OPENAI_BASE_URL, so the default suits any
# OpenAI-compatible server.
#NEU_LLM_PI_PROVIDER=openai
#NEU_LLM_PI_ARGS=

# --- rails (all optional, shown at their defaults) ---------------------------

# Colon-separated directories the read-only tools may look inside. Everything
# outside is refused before any file is opened, and the deny list in the script
# (.ssh, *.env, *.pem, ...) still wins inside these.
#NEU_LLM_ROOTS=~/dev:~/.config:~/.local/state/neu

# 0 turns the tools off entirely -- plain chat, no filesystem access at all.
#NEU_LLM_TOOLS=1

# Turns of history replayed to the model each request.
#NEU_LLM_CTX=12

# Tool round-trips allowed within one turn, so a confused model cannot spin.
#NEU_LLM_MAX_STEPS=6

# builtin only. The one directory it may write to unasked; a bare filename goes
# here. Everything else inside NEU_LLM_ROOTS raises an approval card in the
# panel with a diff, and the deny list is refused even if you approve it.
#NEU_LLM_SCRATCH=~/dev/llm-scratch

# 0 removes the write tool entirely, back to a read-only assistant.
#NEU_LLM_WRITE=1

# --- the compute gateway (bellows) -------------------------------------------

# There is one GPU and more than one thing that wants it, and LM Studio evicts
# whatever is loaded to make room for whatever a request names -- so two
# consumers asking for two models thrash the card rather than share it. bellows
# runs ON the box with the card and puts a queue in front of it.
#
# Point NEU_LLM_URL at the gateway instead of at LM Studio and nothing else
# changes. Its /v1/chat/completions speaks exactly what LM Studio speaks; the
# port is the only edit:
#
#   NEU_LLM_URL=http://192.168.1.2:8322/v1     the gateway
#   NEU_LLM_URL=http://192.168.1.2:1234/v1     LM Studio itself, unqueued
#
# Both work. Everything below degrades quietly against the second one, so the
# way back is to change this line and nothing else.
#
# The panel declares itself INTERACTIVE, which is what keeps a keystroke off
# the back of a 600-call NPC bake -- it goes to the front of the queue. It does
# not interrupt work already on the card, though: an asset job in flight is
# still minutes, and the panel now says so in its status line rather than
# sitting there looking crashed. That line comes from GET /v1/queue, which
# plain LM Studio does not have; the panel asks once, notices, and never
# mentions it again.
#
# One thing is genuinely worse behind the gateway: the model picker stops
# marking which model is already loaded. `state` comes from LM Studio's own
# /api/v0/models, which is not part of the OpenAI protocol and which the
# gateway does not forward. The list is still right; nothing is highlighted.
#
# pi and opencode reach the endpoint themselves rather than through the panel,
# so they cannot send the interactive header and their turns queue as ordinary
# batch work. Use the builtin harness if the card is contended.

# Seconds of silence before a turn is abandoned. The gateway's drop-in BLOCKS:
# it buffers the whole answer and sends it at the end, so a queued turn is
# silent from send to finish and this has to cover the wait AND the generation.
# The gateway's own upstream timeout is 900s, so keep this above that or its
# answer arrives after we have stopped listening.
#NEU_LLM_TIMEOUT=1200
