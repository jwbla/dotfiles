{
  "$schema": "./tokens.schema.json",
  "$source": {
    "package": "@rgtv/neu v3.1.0",
    "repo": "~/dev/rgtv-ds",
    "files": [
      "src/theme/palette.css   -> ctp, brand",
      "src/themes.ts           -> surface (themes.dark)",
      "src/theme/variables.css -> size, radius, border, shadow, type, motion, z, overlay, domain",
      "src/shade.ts            -> shadeSteps (oklch mixing)",
      "src/demos6.stories.tsx  -> the NeuOS (Desktop) story this desktop is modelled on"
    ],
    "note": "palette.css says its Catppuccin block was 'pulled verbatim from ~/dev/dotfiles/waybar/mocha.css'. This file sends it back the other way."
  },
  "ctp": {
    "rosewater": "#f5e0dc",
    "flamingo": "#f2cdcd",
    "pink": "#f5c2e7",
    "mauve": "#cba6f7",
    "red": "#f38ba8",
    "maroon": "#eba0ac",
    "peach": "#fab387",
    "yellow": "#f9e2af",
    "green": "#a6e3a1",
    "teal": "#94e2d5",
    "sky": "#89dceb",
    "sapphire": "#74c7ec",
    "blue": "#89b4fa",
    "lavender": "#b4befe",
    "text": "#cdd6f4",
    "subtext1": "#bac2de",
    "subtext0": "#a6adc8",
    "overlay2": "#9399b2",
    "overlay1": "#7f849c",
    "overlay0": "#6c7086",
    "surface2": "#585b70",
    "surface1": "#45475a",
    "surface0": "#313244",
    "base": "#1e1e2e",
    "mantle": "#181825",
    "crust": "#11111b"
  },
  "brand": {
    "lightestPrimary": "#bc97f3",
    "lightPrimary": "#9b58e7",
    "primary": "#8b2fe0",
    "darkPrimary": "#3a0f63",
    "lightestSecondary": "#ff9cc6",
    "lightSecondary": "#ff5da9",
    "secondary": "#ff2e9a",
    "darkSecondary": "#710e42",
    "lightTertiary": "#58d5cc",
    "tertiary": "#15cdc3",
    "darkTertiary": "#045a55"
  },
  "surface": {
    "bg": "#141414",
    "bgComponent": "#171717",
    "bgCard": "#181818",
    "shadowDark": "#000000",
    "shadowLight": "#555555",
    "hoverHighlight": "#232323",
    "text": "#cccccc",
    "textMuted": "#999999",
    "textDim": "#888888"
  },
  "status": {
    "success": {
      "hue": "green",
      "glow": 70
    },
    "error": {
      "hue": "red",
      "glow": 70
    },
    "info": {
      "hue": "blue",
      "glow": 60
    },
    "warning": {
      "hue": "peach",
      "glow": 60
    }
  },
  "accentGlow": 60,
  "domain": {
    "1": "#ee204d",
    "2": "#ff7538",
    "3": "#ffc60a",
    "4": "#28c76f",
    "5": "#00c2de",
    "6": "#1f75fe",
    "7": "#7c3aed",
    "8": "#ff49c0"
  },
  "shadeSteps": {
    "lightest": 45,
    "lighter": 30,
    "light": 15,
    "dark": -15,
    "darker": -30,
    "darkest": -45
  },
  "size": {
    "xxs": 2,
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "s": 8,
    "m": 16,
    "l": 32
  },
  "border": {
    "xs": 1,
    "s": 2,
    "m": 3,
    "l": 4
  },
  "hairlineMix": 22,
  "shadow": {
    "_rule": "blur = 2 x offset; dark shadow at +offset (bottom-right), light at -offset (top-left). gap = offset + blur, the reach a neighbour must be spaced by.",
    "xxs": {
      "offset": 1,
      "blur": 3,
      "gap": 4
    },
    "xs": {
      "offset": 2,
      "blur": 4,
      "gap": 6
    },
    "s": {
      "offset": 3,
      "blur": 6,
      "gap": 9
    },
    "m": {
      "offset": 4,
      "blur": 8,
      "gap": 12
    },
    "l": {
      "offset": 5,
      "blur": 10,
      "gap": 15
    },
    "xl": {
      "offset": 7,
      "blur": 14,
      "gap": 21
    }
  },
  "shadowInset": {
    "xs": {
      "offset": 2,
      "blur": 4
    },
    "s": {
      "offset": 3,
      "blur": 6
    },
    "m": {
      "offset": 4,
      "blur": 8
    },
    "l": {
      "offset": 5,
      "blur": 12
    }
  },
  "shadowOverlay": {
    "offset": 5,
    "blur": 14
  },
  "shadowDrop": {
    "right": {
      "x": 4,
      "blur": 12
    },
    "bottom": {
      "y": 4,
      "blur": 8
    }
  },
  "focusRing": 3,
  "overlayTint": {
    "shadeSubtle": 0.075,
    "shadeSoft": 0.15,
    "shadeMedium": 0.3,
    "shadeStrong": 0.4,
    "highlightSubtle": 0.05,
    "highlightSoft": 0.15,
    "highlightMedium": 0.25
  },
  "type": {
    "rootPx": 16,
    "rem": {
      "xs": 0.7,
      "s": 0.8,
      "m": 0.9,
      "l": 1.0,
      "xl": 1.1,
      "xxl": 1.25,
      "xxxl": 1.6
    },
    "weight": {
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "leading": {
      "none": 1.0,
      "tight": 1.2,
      "snug": 1.4,
      "normal": 1.5,
      "relaxed": 1.6
    },
    "tracking": {
      "_note": "uppercase-only device; never applied to content text",
      "section": 0.1,
      "group": 0.06,
      "header": 0.05,
      "stat": 0.04,
      "cta": 0.01
    },
    "font": {
      "_note": "DS asks for 'Roboto', sans-serif. Not installed here; UbuntuMono Nerd carries the shell because it has the glyphs. `pacman -S ttf-roboto` to match the DS exactly, then swap `ui` below.",
      "ui": "Adwaita Sans",
      "mono": "UbuntuMono Nerd Font",
      "monoPropo": "UbuntuMono Nerd Font Propo",
      "shell": "UbuntuMono Nerd Font"
    }
  },
  "motion": {
    "fastMs": 150,
    "baseMs": 200,
    "defaultMs": 300,
    "slowMs": 500,
    "rainbowMs": 20000,
    "spinnerMs": 800,
    "shimmerMs": 1800,
    "toastInMs": 350,
    "toastOutMs": 300
  },
  "z": {
    "raised": 10,
    "sticky": 100,
    "dropdown": 200,
    "overlay": 1000,
    "toast": 9999
  },
  "scrollbar": {
    "widthPx": 10,
    "thumbMix": 45
  },
  "desktop": {
    "_note": "values with no DS counterpart - the desktop's own dimensions. barBlurAlpha is near-opaque, not 0.8: Hyprland 0.56.2 does not honour hl.layer_rule blur for these namespaces (verified with dim_around), so a translucent panel would just show sharp text through it.",
    "barHeight": 42,
    "barBlurAlpha": 0.97,
    "dockIconPx": 40,
    "dockMagnify": {
      "hovered": 1.4,
      "neighbour": 1.2,
      "rest": 1.0
    },
    "meterSegments": 12,
    "wallpaper": {
      "width": 1920,
      "height": 1080,
      "style": "solid",
      "_note": "solid | bloom. 'solid' paints --neu-bg flat, which is what rgtv-com's own frontend does (`body { background: var(--neu-bg) }` in appStyles.css, under the DS default 'dark' theme) -- so the desktop ground is literally the same colour the site ships. 'bloom' is the NeuOS story's accent radial gradient."
    },
    "user": {
      "name": "jwbla",
      "initials": "JW"
    },
    "windowBorder": 1,
    "windowShadowTier": "s"
  },
  "icons": {
    "_note": "Hex codepoints, never literal glyphs: nerd-font chars in the BMP private-use area (U+E000-F8FF) do not survive being written to disk. gen.py turns these into QML \\uXXXX escapes (surrogate pairs above the BMP). Ramps are ordered low -> high.",
    "batteryRamp": [
