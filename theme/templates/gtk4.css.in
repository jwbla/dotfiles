/* {{stamp}} */
/*
 * libadwaita reads these named colours at runtime, so GTK4 apps pick up the neu
 * ground without a theme engine. Widget geometry stays stock Adwaita; only the
 * palette and the relief change.
 */

@define-color window_bg_color {{bg}};
@define-color window_fg_color {{text}};
@define-color view_bg_color {{bgComponent}};
@define-color view_fg_color {{text}};
@define-color headerbar_bg_color {{bgComponent}};
@define-color headerbar_fg_color {{text}};
@define-color headerbar_border_color {{hairlineOnBg}};
@define-color headerbar_backdrop_color {{bg}};
@define-color headerbar_shade_color {{shadowDark}};
@define-color card_bg_color {{bgCard}};
@define-color card_fg_color {{text}};
@define-color card_shade_color {{shadowDark}};
@define-color dialog_bg_color {{bgCard}};
@define-color dialog_fg_color {{text}};
@define-color popover_bg_color {{bgCard}};
@define-color popover_fg_color {{text}};
@define-color popover_shade_color {{shadowDark}};
@define-color sidebar_bg_color {{bgComponent}};
@define-color sidebar_fg_color {{text}};
@define-color sidebar_border_color {{hairlineOnBg}};
@define-color sidebar_backdrop_color {{bg}};
@define-color secondary_sidebar_bg_color {{bg}};
@define-color secondary_sidebar_fg_color {{textMuted}};
@define-color thumbnail_bg_color {{bgCard}};
@define-color thumbnail_fg_color {{text}};

@define-color accent_color {{accent_light}};
@define-color accent_bg_color {{primary}};
@define-color accent_fg_color {{ink_primary}};

@define-color destructive_color {{error}};
@define-color destructive_bg_color {{error}};
@define-color destructive_fg_color {{ink_error}};
@define-color success_color {{success}};
@define-color success_bg_color {{success}};
@define-color success_fg_color {{ink_success}};
@define-color warning_color {{warning}};
@define-color warning_bg_color {{warning}};
@define-color warning_fg_color {{ink_warning}};
@define-color error_color {{error}};
@define-color error_bg_color {{error}};
@define-color error_fg_color {{ink_error}};

@define-color shade_color {{shadowDark}};
@define-color scrollbar_outline_color {{shadowDark}};
@define-color borders {{hairlineOnBg}};

button {
  border-radius: {{radius_s}}px;
  box-shadow:
    {{shadow_xs_offset}}px {{shadow_xs_offset}}px {{shadow_xs_blur}}px {{shadowDark}},
    -{{shadow_xs_offset}}px -{{shadow_xs_offset}}px {{shadow_xs_blur}}px {{shadowLight}};
}

button:active,
button:checked {
  box-shadow:
    inset {{shadow_xs_offset}}px {{shadow_xs_offset}}px {{shadow_xs_blur}}px {{shadowDark}},
    inset -{{shadow_xs_offset}}px -{{shadow_xs_offset}}px {{shadow_xs_blur}}px {{shadowLight}};
}

button:disabled {
  box-shadow: none;
  opacity: 0.5;
}

entry, spinbutton {
  border-radius: {{radius_s}}px;
  box-shadow:
    inset {{shadow_xs_offset}}px {{shadow_xs_offset}}px {{shadow_xs_blur}}px {{shadowDark}},
    inset -{{shadow_xs_offset}}px -{{shadow_xs_offset}}px {{shadow_xs_blur}}px {{shadowLight}};
}

scrollbar slider {
  background-color: {{scrollThumb}};
  border-radius: {{size_xs}}px;
}

scrollbar slider:hover {
  background-color: {{primary}};
}
