# generated by theme/gen.py from theme/tokens.json; do not edit
#
# The NeuToast recipe (src/neu/neu-toast/neu-toast.css) in dunst. dunst is no
# longer the notification daemon -- the Quickshell NotificationLayer is -- but it
# stays configured so panic mode and any bare `dunstify` still look right.
#
# dunst can only draw a full frame, not a left rail, so the toast's 4px accent
# rail becomes a 4px accent frame, tinted per urgency exactly as the web toast is.

[global]
    monitor = 0
    follow = mouse

    width = (280, 420)
    height = (0, 300)
    origin = top-right
    offset = (15, 57)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 180
    progress_bar_max_width = 380
    progress_bar_corner_radius = 4

    indicate_hidden = yes
    separator_height = 15
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 4
    gap_size = 15
    corner_radius = 16

    separator_color = frame
    sort = yes

    font = UbuntuMono Nerd Font 14
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = end
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    enable_recursive_icon_lookup = true
    icon_theme = breeze-dark
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    sticky_history = yes
    history_length = 20
    browser = librewolf
    always_run_script = true
    title = dunst
    class = dunst
    corner_radius_bottom = 16
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#181818"
    foreground = "#999999"
    frame_color = "#888888"
    highlight = "#8b2fe0"
    timeout = 6

[urgency_normal]
    background = "#181818"
    foreground = "#cccccc"
    frame_color = "#8b2fe0"
    highlight = "#8b2fe0"
    timeout = 8

[urgency_critical]
    background = "#181818"
    foreground = "#cccccc"
    frame_color = "#f38ba8"
    highlight = "#f38ba8"
    timeout = 0
