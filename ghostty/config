# ghostty. See `ghostty +show-config --default --docs` for everything available.

font-family = UbuntuMono Nerd Font
font-size = 14

theme = Catppuccin Mocha

window-padding-x = 8
window-padding-y = 6
window-decoration = none
confirm-close-surface = false

# The neu palette, when the rgtv dotfiles are installed. The `?` prefix means
# "skip silently if absent", and a config-file is loaded AFTER the file naming
# it, so ~/.config/ghostty/neu.conf wins over the theme above while it exists.
# Removing that repo reverts this terminal to Catppuccin with no edit here.
config-file = ?neu.conf
