# Environment for neu-ntfy.service -- fleet alerts into desktop notifications.
#
# Copy to ~/.config/neu/ntfy.env and fill in. That file holds a read token, so:
#
#   install -d -m 700 ~/.config/neu
#   install -m 600 /dev/null ~/.config/neu/ntfy.env
#   $EDITOR ~/.config/neu/ntfy.env
#
# NEVER commit the real file, and never paste real values back into this
# template. Every value below lives on the fleet ntfy container (CT 911) in
# /opt/rgtv/.env -- read them there, do not copy them anywhere else.

# Base URL of the fleet ntfy server. No trailing slash, no topic.
#NTFY_URL=http://<ntfy-host>:<port>

# The topic the Proxmox `fleet-to-ntfy` matcher publishes to.
#NTFY_TOPIC=

# A token with READ access to that topic. Leave commented out if the topic is
# open; the subscriber sends no Authorization header when this is empty.
#NTFY_TOKEN=

# --- tuning (all optional, shown at their defaults) --------------------------

# ntfy priority that becomes urgency=critical. Critical toasts never time out,
# so this is the "sticky until acknowledged" threshold. 5 = max only; set 4 to
# include high.
#NTFY_CRITICAL_AT=5

# Reconnect if the stream carries nothing for this long. ntfy keepalives are
# ~45s apart, so this is roughly three missed beats.
#NTFY_STALL_SECS=150

# Put a notification on the desktop after this many consecutive failed
# connections, so an unreachable server never passes for a quiet night.
#NTFY_ALERT_AFTER=5
